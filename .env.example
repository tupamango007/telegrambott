# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# Ключ Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Модель Claude и глубина размышлений (low | medium | high)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# Файл с описанием вашей личности и стиля общения
PERSONA_FILE=persona.md
# Где хранить историю переписки и настройки
DB_PATH=data/bot.sqlite3

# Сколько секунд ждать перед ответом (собеседник может дописать ещё сообщения)
REPLY_DELAY_SECONDS=8
# Если вы сами ответили в чате — бот молчит в нём столько минут
OWNER_TAKEOVER_MINUTES=30
# Сколько последних сообщений чата передавать модели как контекст
HISTORY_LIMIT=40
# Присылать вам в чат с ботом копию каждого автоответа
NOTIFY_OWNER=true
