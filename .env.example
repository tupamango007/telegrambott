# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# Ваш Telegram ID (бот покажет его на /start). Необязательно, но так бот узнаёт
# вас даже после сброса базы — например, при передеплое на хостинге.
OWNER_ID=

# Файл с шаблонами ответов и правилами
REPLIES_FILE=replies.toml
# Где хранить настройки и состояние чатов
DB_PATH=data/bot.sqlite3

# Сколько секунд ждать перед ответом (собеседник может дописать, вы можете ответить сами)
REPLY_DELAY_SECONDS=8
# Если вы сами ответили в чате — бот молчит в нём столько минут
OWNER_TAKEOVER_MINUTES=30
# Не повторять один и тот же шаблон в чате чаще, чем раз в столько минут
REPLY_COOLDOWN_MINUTES=60
# Оповещения вам в личку с ботом:
#   all       — о каждом входящем сообщении (и что ответил бот)
#   replies   — только когда бот ответил за вас
#   important — только о сообщениях по правилам с notify = true
#   off       — без оповещений
# Важные сообщения (notify = true) приходят во всех режимах, кроме off.
NOTIFY_OWNER=all
