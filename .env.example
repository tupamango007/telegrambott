# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...

# Файл с шаблонами ответов и правилами
REPLIES_FILE=replies.toml
# Где хранить настройки и состояние чатов
DB_PATH=data/bot.sqlite3

# Сколько секунд ждать перед ответом (собеседник может дописать, вы можете ответить сами)
REPLY_DELAY_SECONDS=8
# Если вы сами ответили в чате — бот молчит в нём столько минут
OWNER_TAKEOVER_MINUTES=30
# Не повторять один и тот же шаблон в чате чаще, чем раз в столько минут
REPLY_COOLDOWN_MINUTES=60
# Присылать вам в чат с ботом копию каждого автоответа
NOTIFY_OWNER=true
